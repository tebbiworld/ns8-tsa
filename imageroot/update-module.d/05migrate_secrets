# Up to 1.0.2 the key password was stored with agent.set_env(), i.e. in
# state/environment (mirrored to Redis in plain text), and passed to the server
# on its command line. Move it to state/passwords.env (0600) and write the
# private server configuration file; the value does not change.
#
# The certificate files of such an installation are still owned by a sub-UID:
# tsa-gen-cert --fix-perms takes them back for the module user, the new unit
# no longer needs the foreign ownership.

import os
import subprocess

import modsecrets

modsecrets.migrate_from_env(["TSA_KEY_PASSWORD"])
bindir = os.path.expanduser("~/.config/bin")
certdir = os.path.join(os.environ["AGENT_STATE_DIR"], "certs")
if os.path.isdir(certdir):
    subprocess.run([os.path.join(bindir, "tsa-gen-cert"), certdir, "--fix-perms"], check=True)
if modsecrets.get("TSA_KEY_PASSWORD"):
    subprocess.run([os.path.join(bindir, "tsa-write-config")], check=True)

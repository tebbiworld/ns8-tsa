# The core's update-module action pulls the new images and runs these hooks but
# does not restart the module's units, so a new pinned upstream image (or a
# changed unit file) would only take effect at the next reboot. Restart here.

set -e
exec 1>&2

systemctl --user daemon-reload
systemctl --user try-restart tsa.service

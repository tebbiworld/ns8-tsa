# Validate the optional client IP allowlist: every entry must be a valid IPv4 or
# IPv6 address or CIDR network. The JSON schema only checks that the field is an
# array of strings; the address syntax is checked here with Python's ipaddress
# module so a typo is rejected before it ever reaches the Traefik route.

import os
import sys
import json

import agent
import tsanet

agent.set_weight(os.path.basename(__file__), 0)  # validation step, no progress weight

data = json.load(sys.stdin)
allowlist = data.get("ip_allowlist", [])

invalid = tsanet.validate_allowlist(allowlist)
if invalid:
    agent.set_status("validation-failed")
    json.dump(
        [
            {
                "field": "ip_allowlist",
                "parameter": "ip_allowlist",
                "value": entry,
                "error": "invalid_ip_allowlist_entry",
            }
            for entry in invalid
        ],
        fp=sys.stdout,
    )
    sys.exit(2)

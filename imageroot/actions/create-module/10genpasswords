# Generate the password that encrypts the signing key into state/passwords.env
# (mode 0600): it must not be stored in state/environment, which NS8 mirrors to
# Redis in plain text.

import secrets

import modsecrets

modsecrets.ensure({"TSA_KEY_PASSWORD": secrets.token_urlsafe(24)})
